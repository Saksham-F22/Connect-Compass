{
  "name": "concept-compass",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5199 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "test:smoke": "node ./scripts/smoke-test.mjs && node ./scripts/test-learning-memory.mjs && node ./scripts/test-learning-memory-integration.mjs && node ./scripts/test-concept-matching.mjs && node ./scripts/test-accessibility-revision.mjs && node ./scripts/test-workspace-sections.mjs",
    "deploy": "npm run build && npm --prefix worker run deploy",
    "deploy:secret": "npm --prefix worker run secret:put",
    "test:live-ai": "node ./scripts/test-live-ai.mjs",
    "test:live-rescue": "node ./scripts/test-live-rescue.mjs",
    "test:worker-network": "node ./scripts/test-worker-network.mjs",
    "test:videos": "node ./scripts/test-concept-videos.mjs && node ./scripts/test-youtube-search.mjs",
    "test:launcher-assets": "node ./scripts/test-launcher-assets.mjs",
    "test:ui-navigation": "node ./scripts/test-ui-navigation.mjs",
    "test:learning-memory": "node ./scripts/test-learning-memory.mjs",
    "test:accessibility": "node ./scripts/test-accessibility-revision.mjs",
    "test:memory-integration": "node ./scripts/test-learning-memory-integration.mjs",
    "test:concept-matching": "node ./scripts/test-concept-matching.mjs",
    "test:workspace": "node ./scripts/test-workspace-sections.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
